---
const features = [
  {
    title: "Native only",
    body: "No FFmpeg, GStreamer, or bundled encoder binary. The OS camera and encoder APIs are the media stack.",
  },
  {
    title: "Hardware H.264",
    body: "VideoToolbox, the OS H.264 MFT, and MediaCodec where the platform provides them. Software fallback on macOS.",
  },
  {
    title: "Multiple viewers",
    body: "TCP interleaved and UDP RTP/RTCP, or lock the server to one transport. Late joiners wait at most one GOP.",
  },
  {
    title: "Live SDP",
    body: "profile-level-id and sprop-parameter-sets come from the live SPS/PPS, not a canned description.",
  },
  {
    title: "Optional auth",
    body: "Basic and Digest (MD5 and SHA-256) when you do not want an open publisher on the LAN.",
  },
  {
    title: "Phone as a camera",
    body: "Android keeps streaming under a camera foreground service with a wake lock.",
  },
];
---

<section id="features" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-copper">Capabilities</p>
    <h2 class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl">Built to publish, not to route.</h2>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((item) => (
        <article class="rounded-2xl border border-line p-6">
          <h3 class="font-medium">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper-dim">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
