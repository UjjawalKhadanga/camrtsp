---
const repo = "https://github.com/UjjawalKhadanga/camrtsp";
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-lg font-medium tracking-tight">cam<span class="text-copper">rtsp</span></p>
      <p class="mt-2 max-w-sm text-sm text-mute">
        Native camera capture, hardware H.264, in-process RTSP.
        MIT or Apache-2.0, at your option.
      </p>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-paper-dim">
      <a class="text-paper-dim hover:text-paper" href={repo}>Source</a>
      <a class="text-paper-dim hover:text-paper" href={`${repo}/releases`}>Releases</a>
      <a class="text-paper-dim hover:text-paper" href={`${repo}/blob/master/LICENSE-MIT`}>MIT</a>
      <a class="text-paper-dim hover:text-paper" href={`${repo}/blob/master/LICENSE-APACHE`}>Apache-2.0</a>
    </div>
  </div>
</footer>
