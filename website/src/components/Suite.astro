---
const suite = [
  {
    name: "Desktop CLI",
    what: "camrtsp binary",
    where: "macOS 12+, Windows 10/11 x64",
    capture: "AVFoundation / Media Foundation",
    encode: "VideoToolbox / OS H.264 MFT",
    serve: "Embedded RTSP on :8554",
  },
  {
    name: "Android app",
    what: "Foreground-service APK",
    where: "API 26+",
    capture: "Camera2",
    encode: "MediaCodec AVC",
    serve: "Same server via JNI, wake lock held",
  },
  {
    name: "Shared core",
    what: "Rust crates",
    where: "This workspace",
    capture: "camrtsp-capture",
    encode: "Access units into the server",
    serve: "camrtsp-server + camrtsp-rtp",
  },
];
---

<section id="suite" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-copper">The suite</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-medium tracking-tight sm:text-4xl">
      One RTSP core, three ways to run it.
    </h2>
    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {suite.map((item) => (
        <article class="flex flex-col rounded-2xl border border-line bg-ink-2 p-6">
          <h3 class="text-xl font-medium">{item.name}</h3>
          <p class="mt-1 font-mono text-sm text-copper">{item.what}</p>
          <dl class="mt-6 space-y-4 text-sm">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Where</dt>
              <dd class="mt-1 text-paper-dim">{item.where}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Capture</dt>
              <dd class="mt-1 text-paper-dim">{item.capture}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Encode</dt>
              <dd class="mt-1 text-paper-dim">{item.encode}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mute">Serve</dt>
              <dd class="mt-1 text-paper-dim">{item.serve}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm text-mute">
      Linux capture is a stub in this beta. iOS, RTSP-over-TLS, and a desktop GUI are out of scope for v0.
    </p>
  </div>
</section>
