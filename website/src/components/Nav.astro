---
const repo = "https://github.com/UjjawalKhadanga/camrtsp";
const links = [
  { href: "#why", label: "Why" },
  { href: "#suite", label: "Suite" },
  { href: "#start", label: "Quick start" },
  { href: "#play", label: "Play" },
];
---

<header
  class="sticky top-0 z-40 border-b border-line bg-ink/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-2.5 font-medium tracking-tight">
      <span
        class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-line bg-ink-2"
      >
        <svg viewBox="0 0 32 32" class="h-4 w-4" aria-hidden="true">
          <rect x="6" y="10" width="20" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <circle cx="16" cy="17.5" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <circle cx="16" cy="17.5" r="2.1" fill="#e08a4f"></circle>
          <rect x="11" y="7" width="10" height="3.2" rx="1" fill="currentColor"></rect>
        </svg>
      </span>
      <span>cam<span class="text-copper">rtsp</span></span>
    </a>
    <nav class="hidden items-center gap-7 text-sm text-paper-dim md:flex">
      {links.map((link) => (
        <a class="text-paper-dim transition hover:text-paper" href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a
      href={repo}
      class="rounded-full border border-line bg-ink-2 px-3.5 py-1.5 text-sm text-paper transition hover:border-paper/30 hover:bg-ink-3"
    >
      GitHub
    </a>
  </div>
</header>
