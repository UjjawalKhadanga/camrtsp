---
const tabs = [
  { id: "macos", label: "macOS" },
  { id: "windows", label: "Windows" },
  { id: "android", label: "Android" },
];

const blocks = {
  macos: `$ cargo build --release -p camrtsp
$ ./target/release/camrtsp devices
$ ./target/release/camrtsp --camera 0`,
  windows: `cargo test --workspace
cargo run -p camrtsp -- devices --json
cargo run -p camrtsp -- --camera 0 --transport tcp`,
  android: `$ scripts/build-android.sh
$ cd apps/android && ./gradlew assembleDebug

Grant camera access, tap Start streaming,
then open rtsp://<phone-lan-ip>:8554/camera`,
};
---

<section id="start" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-copper">Quick start</p>
    <h2 class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl">From clone to URL in one binary.</h2>
    <div class="mt-10 rounded-2xl border border-line bg-ink-2">
      <div class="flex items-center justify-between gap-3 border-b border-line p-2">
        <div class="flex min-w-0 flex-1 gap-1 overflow-x-auto" role="tablist" aria-label="Platform">
          {tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              data-tab={tab.id}
              aria-selected={index === 0 ? "true" : "false"}
              class:list={[
                "rounded-lg px-4 py-2 font-mono text-sm transition",
                index === 0 ? "bg-paper text-ink" : "text-mute hover:text-paper",
              ]}
            >
              {tab.label}
            </button>
          ))}
        </div>
        <button
          id="start-copy"
          type="button"
          data-copy={blocks.macos}
          class="mr-1 shrink-0 rounded-lg border border-line bg-ink px-3 py-1.5 font-mono text-xs text-mute hover:text-paper"
        >
          <span data-copy-label>Copy</span>
        </button>
      </div>
      {Object.entries(blocks).map(([id, code], index) => (
        <div data-panel={id} data-snippet={code} hidden={index !== 0}>
          <pre class="overflow-x-auto p-6 font-mono text-sm leading-7 text-paper-dim"><code>{code}</code></pre>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-paper-dim">
      Windows capture and encode are implemented. A live camera → player pass is not part of CI;
      treat Windows as unverified until you run that check locally.
    </p>
  </div>
</section>
